# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/radar_classification?retryWrites=true&w=majority
MONGODB_URI=

# Python Command ('python' on Windows/Linux, 'python3' on some hosting platforms)
PYTHON_CMD=python

# Default Google Drive link shown on the website
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1rVmUWYyHWgEyzrUYRLMaoy2uvZ0M1t_O?usp=sharing
